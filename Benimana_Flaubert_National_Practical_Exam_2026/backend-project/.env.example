# Server
# PORT is provided automatically by Render in production; keep 5000 locally.
PORT=5000
NODE_ENV=development
SESSION_SECRET=change-me
# In production set this to your deployed frontend URL, e.g. https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=VRS
DB_USER=root
DB_PASSWORD=change-me
# Set DB_SSL=true when using a hosted MySQL provider that requires TLS
# (Aiven, TiDB Cloud, etc.). Leave unset/false for local MySQL.
DB_SSL=false

# Seed admin (created on first startup)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_RECOVERY_CODE=1234
