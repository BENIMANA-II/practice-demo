# Server
# PORT is provided automatically by Render in production; keep 5000 locally.
PORT=5000
NODE_ENV=development
SESSION_SECRET=change-me
# In production set this to your deployed frontend URL, e.g. https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# MongoDB connection
# Local:  mongodb://127.0.0.1:27017/VRS
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/VRS
# Optional: database name. If your URI already ends with /VRS you can leave this unset.
DB_NAME=VRS

# Seed admin (created on first startup)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_RECOVERY_CODE=1234
