# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database (MongoDB / Mongoose) ---
MONGODB_URI=mongodb://localhost:27017/SMS

# --- Session ---
SESSION_SECRET=local-dev-secret-please-change-1234567890

# --- CORS (frontend origin allowed to send credentials) ---
CLIENT_URL=http://localhost:5173

# --- Seeded admin (created on first run if Users is empty) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_RECOVERY_CODE=1234
